# WhatsApp Configuration
# Pairing method: 'code' (recommended for VPS / 8-digit code) or 'qr' (terminal QR)
PAIRING_METHOD=code

# Phone number in international format without '+' or spaces (e.g. 15551234567). Required if PAIRING_METHOD=code
PHONE_NUMBER=

# Your own WhatsApp JID (phone_number@s.whatsapp.net). Used to recognize your Second Brain commands.
OWNER_JID=

# Storage Paths
DATABASE_PATH=./data/messiah.db
SESSIONS_DIR=./sessions

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Discord Emergency Escalation Webhook
DISCORD_WEBHOOK_URL=

# Messiah Ghost-Handler Behavior
# 1 = enabled, 0 = disabled (only second brain runs)
GHOST_HANDLER_ENABLED=1

# Typing simulation speed in ms per character (default: 45)
TYPING_SPEED_MS=45

# Maximum typing delay in ms (default: 8000)
MAX_TYPING_DELAY_MS=8000
